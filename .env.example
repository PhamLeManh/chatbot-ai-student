# ==============================================================================
# TEMPLATE CẤU HÌNH MÔI TRƯỜNG - AI STUDENT ASSISTANT NTU
# ==============================================================================

PORT=5000
NODE_ENV=production

# MongoDB Atlas URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/chatbot_student_db?retryWrites=true&w=majority

# JWT Session Secret
JWT_SECRET=your_super_strong_jwt_secret_key_here

# Gmail SMTP Configuration
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Google Gemini API Key (Khuyên dùng - Free & Cực nhanh)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Tùy chọn)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Upload settings
MAX_FILE_SIZE=20971520
UPLOAD_DIR=uploads/
